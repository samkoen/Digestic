# Copie ce fichier en .env et adapte les valeurs.

# PostgreSQL local (ex. utilisateur postgres, base digestic)
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@127.0.0.1:5432/digestic

# Optionnel : logs SQL dans la console
# SQL_ECHO=1

# Clé de signature des cookies de session (FastAPI / Starlette) — génère une chaîne aléatoire en prod
# SECRET_KEY=

# --- Installation : script scripts/seed_install.py (ou arguments --admin-email / --admin-password) ---
# INSTALL_ADMIN_EMAIL=admin@exemple.com
# INSTALL_ADMIN_PASSWORD=choisir_un_mot_de_passe_fort

# --- VosFactures (API facturation) : https://github.com/vosfactures/API
# Jeton : Paramètres > Paramètres du compte > Intégration > Code d'autorisation API
# VOSFACTURES_API_TOKEN=
# Sous-domaine seul (ex. monentreprise pour https://monentreprise.vosfactures.fr)
# VOSFACTURES_SUBDOMAIN=
# Raison sociale émetteur (obligatoire pour POST invoices.json — sinon erreur 422 sur seller_name)
# Pour être cohérent avec une facture Sage « LES LABORATOIRES DIGESTIC », utiliser la même raison sociale.
# VOSFACTURES_SELLER_NAME=LES LABORATOIRES DIGESTIC
# Optionnel : ID du département vendeur (fiche compagnie, visible dans l’URL)
# VOSFACTURES_DEPARTMENT_ID=
# true = documents « test » sur VosFactures (recommandé pendant l’intégration)
# VOSFACTURES_TEST=true
# true = n’appelle pas VosFactures (mock local)
# VOSFACTURES_USE_MOCK=false

# --- Brevo (e-mails transactionnels) — https://www.brevo.com/ — forfait gratuit dispo (quotas mensuels)
# Crée une clé API : SMTP & API > Clés API ; l’expéditeur doit être vérifié (Senders / domaine).
# BREVO_API_KEY=xkeysib-xxxx
# Adresse « From » obligatoirement validée dans l’espace Brevo
# BREVO_SENDER_EMAIL=noreply@ton-domaine.fr
# BREVO_SENDER_NAME=Digestic
# true = mode tests : aucun envoi livré hors BREVO_SANDBOX_RECIPIENT (l’API Brevo est utilisée si clé + expéditeur OK)
# BREVO_USE_SIMULATION=false
# Override optionnel du destinataire unique en mode BREVO_USE_SIMULATION=true (valeur codée sinon)
# BREVO_SANDBOX_RECIPIENT=
